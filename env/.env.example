NODE_ENV=production

# Supabase Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# Medusa secrets
JWT_SECRET=CHANGE_ME
COOKIE_SECRET=CHANGE_ME

# CORS (Cloudflare Pages 도메인)
STORE_CORS=https://shop.vetlinkr.com
ADMIN_CORS=https://admin.vetlinkr.com
AUTH_CORS=https://shop.vetlinkr.com,https://admin.vetlinkr.com

# R2 (이미지 스토리지)
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=your-public-assets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://assets.vetlinkr.com

# Tunnel (전환 시에만)
TUNNEL_TOKEN=
